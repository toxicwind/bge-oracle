# bge-oracle — copy to `.env` for non-estate setups.
# The estate already serves FREEINFERENCE_API_KEY from the secretsmith keyring
# (fastest) — env/.env are only consulted when the keyring is unavailable.

# ── API key (any ONE of these) ────────────────────────────────────────────
# 1. secretsmith keyring label FREEINFERENCE_API_KEY  (estate SSOT, default)
# 2. FREEINFERENCE_API_KEY=<your key>                 (plain env / this file)
# 3. HF_API_KEY=<legacy alias>                        (kept for compatibility)

# ── Embeddings endpoint ───────────────────────────────────────────────────
# Default: the estate's canonical bge-m3 lane (freeinference.org, 1024-dim,
# unlimited/free). Point at ANY OpenAI-compatible `/v1/embeddings` server:
#   BGE_EMBED_BASE_URL=http://127.0.0.1:8080/v1/embeddings
#   BGE_EMBED_BASE_URL=https://your-gateway.example/v1/embeddings
# (legacy alias: HF_BASE_URL)

# ── Model ─────────────────────────────────────────────────────────────────
# BGE_EMBED_MODEL=bge-m3   # any model the endpoint supports (default bge-m3)